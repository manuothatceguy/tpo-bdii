{
  "name": "FarmaRed",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/tpo-bdii",
  "postCreateCommand": "npm ci && npm run load_data",
  "forwardPorts": ["mongo:27017", "redis:6379"],
  "portsAttributes": {
    "mongo:27017": { "label": "mongodb" },
    "redis:6379": { "label": "redis" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["mongodb.mongodb-vscode"]
    }
  }
}
